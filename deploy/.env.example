# Development-only defaults. Do not use these credentials in shared or production environments.
ATLAS_INFERENCE_PROVIDER=ollama
ATLAS_INFERENCE_MODEL=gemma3
ATLAS_INFERENCE_MAX_ATTEMPTS=3
ATLAS_DATABASE_URL=postgres://atlas:atlas-dev-password@postgres:5432/atlas?sslmode=disable
INFERENCE_GATEWAY_PORT=8080

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-dev-password
POSTGRES_PORT=5432

REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OLLAMA_PORT=11434
